+      'node_settings_client_chain',
+      'node_settings_chain_save',
+    }.contains(node.key)) return true;
+    FadeThroughTransition? entrance;
+    bool settled = true;
+    node.element.visitAncestorElements((Element ancestor) {
+      if (ancestor is StatefulElement) {
+        final State<StatefulWidget> state = ancestor.state;
+        if (state is ScrollableState &&
+            state.position.isScrollingNotifier.value) {
+          settled = false;
+          return false;
+        }
+      }
+      final Widget widget = ancestor.widget;
+      if (widget is FadeThroughTransition) entrance = widget;
+      if (widget is RiseSwitcher) {
+        final FadeThroughTransition? original = entrance;
+        if (original == null || !original.animation.isCompleted ||
+            !original.secondaryAnimation.isDismissed) {
+          settled = false;
+          return false;
+        }
+        entrance = null;
+      }
+      return true;
+    });
+    return settled;
+  }
